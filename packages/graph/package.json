{
  "name": "@alineo-labs/graph",
  "version": "0.0.0",
  "description": "Knowledge graph projections over alineo's event ledger: a runtime provenance graph and a security/governance graph, built on graphology.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrejT/alineo.git",
    "directory": "packages/graph"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@alineo-labs/schema": "workspace:*",
    "graphology": "0.26.0",
    "graphology-shortest-path": "2.1.0"
  },
  "devDependencies": {
    "@alineo-labs/ledger": "workspace:*",
    "bun-types": "1.4.2",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}

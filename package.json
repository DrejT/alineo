{
  "name": "alineo",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/opensandbox",
    "packages/logger",
    "packages/config-shared",
    "packages/schema",
    "packages/sdks/typescript",
    "packages/workflow",
    "packages/adapters/postgres",
    "packages/adapters/sqlite",
    "packages/adapters/sqlite-memory",
    "packages/adapters/postgres-memory",
    "packages/adapters/otel",
    "packages/adapters/flue",
    "packages/adapters/vault",
    "packages/agent",
    "packages/agent-browser",
    "packages/instructions",
    "packages/memory",
    "packages/model-providers",
    "packages/cli",
    "packages/cli-shared",
    "packages/mcp",
    "examples/*",
    "cookbooks/*",
    "tests/integration",
    "apps/docs",
    "apps/docs-mcp",
    "apps/registry",
    "apps/sandbox",
    "apps/telemetry",
    "apps/alineod"
  ],
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "build": "bun scripts/workspace-run.ts build",
    "typecheck": "bun scripts/workspace-run.ts typecheck",
    "test": "bun scripts/workspace-run.ts test",
    "test:integration": "bun run --cwd tests/integration test",
    "check:vocabulary": "bun scripts/check-vocabulary.ts",
    "lint": "oxlint packages examples cookbooks && oxlint -c .oxlintrc.console.json apps/alineod apps/sandbox/server",
    "lint:fix": "oxlint --fix packages examples cookbooks",
    "format": "oxfmt packages examples cookbooks apps \"!**/CHANGELOG.md\"",
    "format:check": "oxfmt --check packages examples cookbooks apps \"!**/CHANGELOG.md\"",
    "release:version": "bun changeset version",
    "release:publish": "bun scripts/resolve-workspace-protocol.ts && bun changeset publish"
  },
  "devDependencies": {
    "@alineo-labs/schema": "workspace:*",
    "@changesets/cli": "3.0.2",
    "@oxlint/plugins": "^1.82.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001"
  }
}

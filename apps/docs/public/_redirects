# Cloudflare Pages redirects. apps/docs is a static export (output: "export"), so
# these can't live in next.config.ts's redirects() — that API is unsupported for
# static export. Cloudflare Pages reads this file at the edge instead, ahead of
# Next's own routing.
#
# core and alineo docs were versioned for a while (content/docs/{core,alineo}/vX.Y/,
# URLs like /docs/core/0.3) — that's been removed in favor of a single unversioned
# tree per product, same as workflow/agent/examples always were. These rules keep
# already-indexed versioned URLs (both the current "vX.Y"-dropped scheme and the
# older "vX.Y"-prefixed one) resolving to the live unversioned page instead of 404ing.
/docs/core/v0.1          /docs/core                301
/docs/core/v0.1/*         /docs/core/:splat         301
/docs/core/0.1           /docs/core                301
/docs/core/0.1/*          /docs/core/:splat         301
/docs/core/0.2           /docs/core                301
/docs/core/0.2/*          /docs/core/:splat         301
/docs/core/0.3           /docs/core                301
/docs/core/0.3/*          /docs/core/:splat         301

/docs/alineo/v0.1         /docs/alineo               301
/docs/alineo/v0.1/*        /docs/alineo/:splat        301
/docs/alineo/0.1          /docs/alineo               301
/docs/alineo/0.1/*         /docs/alineo/:splat        301
/docs/alineo/0.2          /docs/alineo               301
/docs/alineo/0.2/*         /docs/alineo/:splat        301
/docs/alineo/0.3          /docs/alineo               301
/docs/alineo/0.3/*         /docs/alineo/:splat        301

# Static export can't perform a real server redirect for "/" — Next instead bakes
# it as an error-boundary shell that a client script replaces via router.replace()
# after hydration, which a no-JS client or crawler would see as the actual response.
# An edge-level 301 here sidesteps that.
/                      /docs/core                301
